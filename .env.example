# Copy to .env and fill in. Never commit real values.

# PHOENIX FastAPI backend (browser-visible). No trailing slash needed.
VITE_API_BASE_URL=

# --- Server-side only ---
# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Lovable AI Gateway key (AI brief and planner)
LOVABLE_API_KEY=
# NASA Earthdata bearer token (LP DAAC; required by pipeline v4)
NASA_EARTHDATA_TOKEN=

# --- Offline pipeline (optional overrides) ---
# PHX_BASE=./data/phoenix_pipeline   (default; the old default was /mnt/documents/phoenix_pipeline)
# PHX_CACHE=/tmp/phx_cache
# PHX_TMP=/tmp/phx_v4
# POWER_AVAILABILITY_LAG_DAYS=3
